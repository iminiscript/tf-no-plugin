{%- if part == 'head' -%}
  <script>
    window.dataLayer = window.dataLayer || [];
    window.__dlDebug = {{ settings.gtm_debug_mode | default: false | json }};
  </script>
  {%- if settings.gtm_container_id != blank -%}
    <script>
      (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
      new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
      j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
      'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
      })(window,document,'script','dataLayer','{{ settings.gtm_container_id | escape }}');
    </script>
  {%- endif -%}
{%- elsif part == 'body' -%}
  {%- if settings.gtm_container_id != blank -%}
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id={{ settings.gtm_container_id | escape }}"
      height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
  {%- endif -%}
{%- endif -%}
